# Server Configuration
PORT=3000
CORS_ORIGIN=*

# Toss API Configuration
# Base URL for Apps in Toss mTLS API (Live/샌드박스 동일)
TOSS_API_URL=https://apps-in-toss-api.toss.im
# Client Certificate and Key (PEM format)
# In Railway, use the raw content. If handling newlines is tricky, ensures they are actual newlines.
TOSS_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n..."
TOSS_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Toss App Info (선택)
# generate-token 요청 시 필요하면 넣음. 공식 콘솔 가이드에 확인 경로 없음. mTLS만으로 동작할 수 있으면 생략 가능.
# TOSS_CLIENT_ID=your-client-id

# Toss Point benefit promotion (Phase 4B)
# 테스트 중에는 TEST_로 시작하는 테스트 프로모션 코드를 넣고,
# 운영 시작 직전에 승인된 실제 프로모션 코드로 교체합니다.
TOSS_BENEFIT_PROMOTION_CODE=TEST_your-promotion-code
# Supabase Edge Function -> Railway BFF 내부 호출용 shared secret입니다.
BENEFIT_BFF_INTERNAL_SECRET=replace-with-long-random-secret
BENEFIT_PROMOTION_RETRY_MAX_ATTEMPTS=5
BENEFIT_PROMOTION_RETRY_INITIAL_DELAY_MS=1000
BENEFIT_PROMOTION_RETRY_MAX_DELAY_MS=30000

# Supabase Configuration
# Use the URL and Service Role Key from your Supabase Project Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 아래 TOSS_REQUIRED_TERMS_TAGS / TOSS_LOGIN_USER_SECRET / TOSS_REFRESH_TOKEN_ENCRYPTION_SECRET 은
# 토스 공식 문서에 정의된 환경변수 이름이 아니라, 본 서비스 BFF 구현 전용입니다. (콘솔·API 계약과 맞추기 위한 우리 쪽 설정명)
# Toss exchange / managed auth configuration
# login-me 응답에 반드시 포함되어야 하는 약관 태그를 콤마로 나열합니다.
TOSS_REQUIRED_TERMS_TAGS=serviceAgreed,privacyPolicyAgreed
# 토스 placeholder 계정의 managed 비밀번호를 결정적으로 만드는 시드입니다.
# 배포마다 바꾸면 기존 토스 연동 계정의 서버 로그인 비밀번호가 달라지므로 고정해야 합니다.
TOSS_LOGIN_USER_SECRET=duxoduddbalstn94
# toss_auth_links.encrypted_refresh_token 암호화용 비밀키입니다.
# 최소 32자 이상이어야 하며, 운영 환경에서는 충분히 긴 랜덤 문자열을 사용해야 합니다.
TOSS_REFRESH_TOKEN_ENCRYPTION_SECRET=duwhdtnghdrmadhrduxoduddbalstndugkdhs118521

# 토스 회원 탈퇴 콜백용 Basic Auth (토스 콘솔에 등록할 값과 동일하게 설정)
TOSS_WEBHOOK_USER=your-webhook-username
TOSS_WEBHOOK_PASSWORD=your-webhook-password
