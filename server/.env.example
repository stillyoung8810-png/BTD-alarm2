# Server Configuration
PORT=3000
CORS_ORIGIN=*

# Toss API Configuration
# Base URL for Apps in Toss mTLS API (Live/샌드박스 동일)
TOSS_API_URL=https://apps-in-toss-api.toss.im
# Client Certificate and Key (PEM format)
# In Railway, use the raw content. If handling newlines is tricky, ensures they are actual newlines.
TOSS_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n..."
TOSS_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Toss App Info (선택)
# generate-token 요청 시 필요하면 넣음. 공식 콘솔 가이드에 확인 경로 없음. mTLS만으로 동작할 수 있으면 생략 가능.
# TOSS_CLIENT_ID=your-client-id

# Supabase Configuration
# Use the URL and Service Role Key from your Supabase Project Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스 회원 탈퇴 콜백용 Basic Auth (토스 콘솔에 등록할 값과 동일하게 설정)
TOSS_WEBHOOK_USER=your-webhook-username
TOSS_WEBHOOK_PASSWORD=your-webhook-password
